# OpenAI API configuration
OPENAI_API_KEY=your-api-key-here

# For a local OpenAI-compatible server such as vLLM, set its URL (usually ending in /v1),
# use a placeholder API key if the server does not require authentication, and set its model name.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=EMPTY
# DEFAULT_MODEL=qwen3-8b

# Defaults to gpt-4o-mini when unset; --model can override this value.
DEFAULT_MODEL=gpt-4o-mini
# Optional: used for embeddings only when --embedding-model openai is selected.
# OPENAI_EMBEDDING_MODEL=your-vllm-embedding-model-name
# DEFAULT_EMBEDDING_MODEL=minilm

# Cache Configuration (Optional)
# CACHE_DIR=./cache
# LOG_LEVEL=INFO
